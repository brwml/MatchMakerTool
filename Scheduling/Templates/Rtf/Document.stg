file(title, date, rooms, rows, teamPairs, headerCellDefs, dataCellDefs, teamCellDefs) ::= "{\rtf1\ansi\deff0{\fonttbl{\f0\fswiss Arial;}{\f1\froman Times New Roman}}{\colortbl;\red26\green54\blue104;\red255\green255\blue255;}{\info{\title{<title>}}{\subject{Meet Schedule}}}<maintitle(title)><daterow(date)>\pard\par<scheduletable(rooms, rows, headerCellDefs, dataCellDefs)>\pard\par\par<teamtable(teamPairs, teamCellDefs)>}"

maintitle(title) ::= "\pard\f1\fs48\b\qc{<title>}\b0\par"

daterow(date) ::= "<if(date)>\pard\f0\fs24\qc{\cf1<date>\cf0}\par<endif>"

scheduletable(rooms, rows, headerCellDefs, dataCellDefs) ::= "<tableheaderrow(rooms, headerCellDefs)><rows:{row|<tabledatarow(row, dataCellDefs)>}>"

tableheaderrow(rooms, headerCellDefs) ::= "{\trowd\trpaddb80\trpaddfb3\trpaddt80\trpaddft3<headerCellDefs>\intbl\cf2\b{}\b0\cf0\cell<rooms:{room|<roomheadercell(room)>}>\row}"

roomheadercell(room) ::= "\intbl\cf2\b{<room>}\b0\cf0\cell"

tabledatarow(row, dataCellDefs) ::= "{\trowd\trpaddb80\trpaddfb3\trpaddt80\trpaddft3<dataCellDefs>\intbl\b{<row.Label>}\b0\cell<row.Cells:{cell|<datacell(cell)>}>\row}"

datacell(cell) ::= "\intbl{<cell>}\cell"

teamtable(teamPairs, teamCellDefs) ::= "<teamPairs:{pair|<teampairrow(pair, teamCellDefs)>}>"

teampairrow(pair, teamCellDefs) ::= "{\trowd\trpaddb80\trpaddfb3\trpaddt80\trpaddft3<teamCellDefs>\intbl{<teamcell(pair.Left)>}\cell\intbl{<teamcell(pair.Right)>}\cell\row}"

teamcell(team) ::= "<if(team)><team.Abbreviation> - <team.Name><endif>"